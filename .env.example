# Public hostname only, without https://. For local HTTP tests use localhost.
PUBLIC_HOST=localhost
PUBLIC_ADDRESS=http://localhost

# Non-secret database settings. Passwords live in Docker secret files.
POSTGRES_DB=nutrioptimize
POSTGRES_USER=nutrioptimize
# File-backed Compose secrets retain their host group. Use the result of
# `id -g` here so non-root containers can read mode-440 secret files.
HOST_SECRET_GID=1000

# Vienna is important: diary dates are calendar dates, not UTC dates.
APP_TIMEZONE=Europe/Vienna

# Safe first run. The fixture adapter never contacts YAZIO.
SYNC_SOURCE=fixture
SYNC_INTERVAL_SECONDS=3600
SYNC_LOOKBACK_DAYS=7

# Only used with compose.yazio.yaml. The private API rejects old client builds,
# so copy the currently documented value from the community specification.
YAZIO_BASE_URL=https://yzapi.yazio.com
YAZIO_API_VERSION=v22
YAZIO_USER_AGENT=
YAZIO_ACCEPT_LANGUAGE=de-AT,de;q=0.9,en;q=0.8
YAZIO_TIMEOUT_SECONDS=20
YAZIO_MAX_CONCURRENCY=4

# Optional browser origins, comma-separated. Non-browser MCP clients omit Origin.
MCP_ALLOWED_ORIGINS=

# Local development keeps the existing random token. For a ChatGPT connection,
# switch to oauth only after configuring a compatible identity provider. The
# issuer value must exactly match the token's `iss` claim, including a trailing
# slash when the provider uses one.
MCP_AUTH_MODE=static
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_RESOURCE_URL=
MCP_OAUTH_REQUIRED_SCOPES=nutrition:read
# Required in OAuth mode: comma-separated stable `sub` claim values. This V1
# stores one person's diary and deliberately refuses an unrestricted OAuth
# configuration until true per-user data isolation exists.
MCP_OAUTH_ALLOWED_SUBJECTS=
